# Database
DATABASE_URL=postgresql://allsports:password@localhost:5432/allsports_dev

# Redis
REDIS_URL=redis://localhost:6379

# Firebase
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# Rating pipeline runs on Redis Streams (REDIS_URL above) — no SQS/AWS queue config.

# AWS S3
S3_BUCKET=allsports-media
S3_REGION=ap-south-1

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug

# Rating Engine
RATING_ENGINE_URL=http://localhost:8000
