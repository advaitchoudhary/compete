# Firebase web config — read from the Firebase console (Project settings → Your apps).
# Not secret: these ship inside every client bundle and identify the project rather
# than authorise anything. Access is controlled by which providers are enabled and
# by the backend verifying the resulting ID token.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Test-harness only. Lets an automated browser complete phone sign-in with a
# number registered as a TEST number in the console — reCAPTCHA cannot complete
# headless. No effect on real numbers; stripped from production builds.
EXPO_PUBLIC_FIREBASE_DISABLE_APP_VERIFICATION=
