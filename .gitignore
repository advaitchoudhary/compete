# ---- dependencies ----
node_modules/

# ---- build output ----
dist/
build/
web-build/
*.tsbuildinfo

# ---- secrets ----
# .env holds a live FIREBASE_PRIVATE_KEY — never commit it.
# .env.example files ARE committed on purpose (they carry no values).
.env
.env.*
!.env.example
!**/.env.example

# ---- logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- expo / react native ----
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# ---- python / rating-engine ----
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/

# ---- test / coverage ----
coverage/

# ---- claude code ----
# Shared project settings ARE committed; per-machine overrides and the
# transient files the CLI writes while saving are not.
.claude/settings.local.json
.claude/settings.json.tmp.*

# ---- editor & os ----
.DS_Store
.idea/
*.swp
